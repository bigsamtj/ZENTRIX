# Phantom v3 – Security & Clean URLs

# Protect sensitive files
<FilesMatch "^(config\.php|\.htaccess)$">
    Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Block direct access to log JSON files, but allow photos
RewriteEngine On

# Block all .json files inside logs/
RewriteRule ^logs/.*\.json$ - [F,L]

# Block the root of logs/ folder (optional extra safety)
RewriteRule ^logs/?$ - [F,L]

# Allow access to logs/photos/
# (no rule needed – it will be allowed by default)

# Optional: force HTTPS (uncomment if you have SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Protect against common attacks
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} ^(TRACE|DELETE|TRACK) [NC]
    RewriteRule .* - [F]
</IfModule>

# Disable server signature
ServerSignature Off

# Prevent access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
